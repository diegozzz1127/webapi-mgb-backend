# ---- Servidor ----
PORT=3000
# Origen permitido para CORS (URL del frontend). Usar * solo en desarrollo.
CORS_ORIGIN=*

# ---- Azure SQL Database ----
# Datos disponibles en el portal de Azure > SQL Database > Cadenas de conexión
DB_SERVER=tu-servidor.database.windows.net
DB_NAME=nombre_base_datos
DB_USER=usuario_sql
DB_PASSWORD=tu_password
DB_PORT=1433
# Azure SQL requiere cifrado
DB_ENCRYPT=true

# ---- Seguridad / JWT ----
# Generar una clave larga y aleatoria. Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_una_clave_secreta_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# ---- Envío de email (Gmail SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Cuenta de Gmail que envía. La contraseña debe ser una "Contraseña de aplicación"
# (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=tu_app_password_de_16_caracteres
# Remitente que se muestra (por defecto usa SMTP_USER)
SMTP_FROM=tu_cuenta@gmail.com
# Destinatario de las denuncias
MAIL_TO=consultora@secureinformatica.com.ar
